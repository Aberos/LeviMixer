{
  "name": "levimixer",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:engine": "dotnet build engine/LeviMixer.slnx",
    "dev": "npm run dev --workspace @levimixer/desktop",
    "start": "npm run start --workspace @levimixer/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "release": "npm run release --workspace @levimixer/desktop"
  }
}

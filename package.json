{
  "name": "mixer",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:engine": "dotnet build engine/Mixer.slnx",
    "dev": "npm run dev --workspace @mixer/desktop",
    "start": "npm run start --workspace @mixer/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}

{
  "name": "@levimixer/desktop",
  "version": "0.1.0",
  "productName": "LeviMixer",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "build": "npm run build:node && npm run build:renderer",
    "build:node": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@levimixer/protocol": "*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

{
  "name": "@levimixer/desktop",
  "version": "1.0.0",
  "productName": "LeviMixer",
  "description": "Mesa de som para o computador: entradas da interface de áudio e o áudio do PC em canais com fader, pan, mute e solo.",
  "author": {
    "name": "Mario Junior",
    "email": "mariosj9@gmail.com"
  },
  "homepage": "https://github.com/Aberos/LeviMixer",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "build": "npm run build:node && npm run build:renderer",
    "build:node": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@levimixer/protocol": "*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
